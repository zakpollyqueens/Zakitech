{
  "name": "zakitech",
  "version": "1.0.0",
  "private": true,
  "description": "ZakiTech company workspace with Android and Windows desktop releases",
  "scripts": {
    "build:android": "npx cap sync android",
    "start:desktop": "electron .",
    "build:windows": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@supabase/supabase-js": "^2.57.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "sharp": "^0.34.3",
    "esbuild": "^0.25.10",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zakmolanitech.zakitech",
    "productName": "ZakiTech",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.html",
      "manifest.json",
      "assets/**/*",
      "electron/**/*",
      "package.json",
      "!assets/icon-only.png",
      "!assets/splash.png",
      "!assets/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ZakiTech-Setup-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZakiTech"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zakpollyqueens",
        "repo": "Zakitech"
      }
    ]
  }
}
